    {
      "sceneId": "scene_002",
      "type": "talking_point",
      "heading": "Your Body Makes Glycine \u2014 But Not Enough",
      "narration": "Glycine is the simplest amino acid. Your body produces it, so it's labeled non-essential. But in people with fatty liver disease, blood glycine levels drop significantly. The body's four production pathways all get disrupted \u2014 threonine and serine aren't converting properly, and the enzymes that break down glycine become overactive. Less production, more destruction.",
      "durationMs": 26850,
      "durationFrames": 805,
      "mood": "informative",
      "evidenceStrength": "moderate",
      "evidenceColor": "#14b8a6",
      "claimsReferenced": [
        "glycine-depletion"
      ],
      "visualNotes": "Bioluminescent human body silhouette showing glowing metabolic pathways and energy streams flowing inside, some pathways dimming and fading to dark amber, dark background, scientific medical visualization, vibrant teal and warm amber colors, cinematic",
      "keywords": [
        "Non-Essential",
        "Depleted",
        "Fatty Liver"
      ],
