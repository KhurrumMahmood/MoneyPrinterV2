    {
      "sceneId": "scene_004",
      "type": "citation",
      "heading": "Blocking Glycine Recovery Worsens Liver Disease",
      "narration": "The animal evidence goes beyond correlation. When researchers knocked out the AGXT1 gene \u2014 removing just one of glycine's four production pathways \u2014 liver disease scores got significantly worse. And when they supplemented glycine directly, liver health improved. This isn't just an association anymore. It's a causal link.",
      "durationMs": 22500,
      "durationFrames": 675,
      "mood": "evidence",
      "evidenceStrength": "strong",
