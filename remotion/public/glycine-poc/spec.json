    {
      "sceneId": "scene_003",
      "type": "image",
      "heading": "Four Pathways, All Disrupted",
      "narration": "Here's what makes this compelling. It's not just one pathway going wrong \u2014 it's four. Threonine, serine, and sarcosine normally convert to glycine, but in liver disease these conversions slow down. Meanwhile, the enzyme DAO actively breaks glycine down into glyoxylate. And AGXT1, the enzyme that converts glyoxylate back to glycine, becomes less active. The glycine pool gets hit from every direction.",
      "durationMs": 30000,
      "durationFrames": 900,
      "mood": "analytical",
      "evidenceStrength": "moderate",
      "evidenceColor": "#14b8a6",
      "claimsReferenced": [
        "glycine-pathways"
      ],
      "visualNotes": "Detailed medical infographic showing four metabolic pathways converging on a central liver organ, clean diagram style with labeled arrows, three pathways marked with red X symbols showing they are blocked, one pathway marked with a dim glow showing it is weakened, dark background, teal and amber color scheme, professional scientific illustration, no text labels, no words, cinematic lighting",
      "keywords": [
        "4 Pathways",
        "Disrupted"
      ],
